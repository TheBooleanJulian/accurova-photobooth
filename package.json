{
  "name": "accurova-photobooth",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable, template-driven, self-service AI photo-booth platform by Accurova.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @accurova/kiosk",
    "dev:lan": "npm run dev:lan -w @accurova/kiosk",
    "build": "npm run typecheck && npm run build -w @accurova/kiosk",
    "preview": "npm run preview -w @accurova/kiosk",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "placeholders": "node scripts/generate-placeholders.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
