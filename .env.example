# Copy to .env and fill in. Never commit real credentials.
# The kiosk runs fully client-side and does not call the API yet. See ROADMAP.md.

# --- Kiosk (Vite, must be prefixed VITE_) ---
# Base URL the kiosk loads templates from. Default: same origin, /templates
VITE_TEMPLATES_BASE_URL=/templates
# Base URL of the FastAPI service (unused until M3)
VITE_API_BASE_URL=http://localhost:8000

# --- API (services/api) ---
PHOTOBOOTH_TEMPLATES_DIR=../../templates
PHOTOBOOTH_CORS_ORIGINS=http://localhost:5173
# Bearer token for /api/admin/cleanup. Admin endpoints are disabled while empty.
PHOTOBOOTH_ADMIN_TOKEN=
# Retention and limits (defaults shown)
PHOTOBOOTH_LINK_EXPIRY_HOURS=24
PHOTOBOOTH_SESSION_TTL_MINUTES=30
PHOTOBOOTH_MAX_UPLOAD_MB=25
PHOTOBOOTH_RATE_LIMIT_PER_MINUTE=30
# Storage: "local" (default, files under services/api/data) or "r2"
PHOTOBOOTH_STORAGE_BACKEND=local
# PHOTOBOOTH_R2_ACCOUNT_ID=
# PHOTOBOOTH_R2_ACCESS_KEY_ID=
# PHOTOBOOTH_R2_SECRET_ACCESS_KEY=
# PHOTOBOOTH_R2_BUCKET=

# --- Not yet used: placeholders for later milestones ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SEGMENTATION_PROVIDER=mock
# SEGMENTATION_API_KEY=
# ADMIN_AUTH_SECRET=
